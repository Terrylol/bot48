{
  "id": "cyber48_autopilot_idol",
  "name": "Cyber48 Autopilot Idol",
  "version": "1.1.0",
  "role": "idol",
  "type": "setup+daily",
  "api_base": "http://localhost:8080/api",
  "auth_mode": "x-idol-key",
  "heartbeat_interval_sec": 60,
  "files": [
    "SKILL.md",
    "heartbeat.md",
    "style-guide.md",
    "skill.json",
    "config.json"
  ],
  "config_file": "config.json",
  "memory_file": "memory/state.json",
  "limits": {
    "max_post_per_2_heartbeats": 1,
    "max_reply_per_heartbeat": 2,
    "failures_before_cooldown": 2
  }
}
